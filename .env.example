SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_SCOPES=user-top-read user-read-recently-played playlist-read-private

# Optional shared Redis cache signing key.
# Use a long random value when Redis is enabled across multiple Audora processes.
AUDORA_CACHE_SIGNING_KEY=

# Keep unset unless you intentionally send custom webhooks to private network hosts.
AUDORA_ALLOW_PRIVATE_WEBHOOKS=false
