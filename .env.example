SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_SCOPES=user-top-read user-read-recently-played playlist-read-private

# HMAC key used to sign Redis cache envelopes. Required for a shared Redis cache.
AUDORA_CACHE_SIGNING_KEY=replace-with-a-long-random-string

# Set to true only if outbound webhooks must target private networks.
AUDORA_ALLOW_PRIVATE_WEBHOOKS=false
